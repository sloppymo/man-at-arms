{
  "name": "man-at-arms",
  "version": "2.0.0",
  "description": "A Man-at-Arms' Life - 100 Years War RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "migrate-stories": "node scripts/ink-to-yarn.js",
    "validate-stories": "node scripts/validate-ink-stories.js",
    "smoke-test": "node scripts/smoke-test-yarn.js",
    "unit-tests": "node scripts/unit-tests.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:working": "jest --config jest.config.cjs --testPathPattern=working.test.js",
    "test:basic": "jest --config jest.config.cjs --testPathPattern=basic.test.js",
    "test:cjs": "jest --config jest.config.cjs --testPathPattern=narrative-service-cjs.test.js",
    "test:smoke": "node __tests__/validation/story-smoke.test.js",
    "compile-stories": "echo 'Yarn stories load directly - no compilation needed'"
  },
  "dependencies": {
    "phaser": "^3.75.1",
    "yarn-bound": "^0.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^30.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^4.4.9"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
