  /**
   * Start a dialog encounter
   */
  startDialogEncounter(dialogId, characterId) {
    const character = CHARACTERS[characterId];
    if (!character) {
      console.error(`Character not found: ${characterId}`);
      return false;
    }

    // Show character portrait
    this.portraitService.showPortrait(characterId, character.portrait.defaultEmotion);

    // Start dialog
    return this.dialogSystem.startDialog(dialogId, character.name);
  }

  /**
   * Get dialog system status
   */
  getDialogSystemStatus() {
    return {
      dialogSystem: this.dialogSystem?.getCurrentState(),
      portraitService: this.portraitService?.getStatus(),
      dialogUI: {
        isVisible: this.dialogUI?.isDialogVisible()
      }
    };
  }

  /**
   * Create a mock story object for when Ink.js compilation fails
   */
  createMockStory(storyText, storyName) {
    return {
      name: storyName,
      text: storyText,
      canContinue: true,
      currentChoices: [],
      
      Continue: function() {
        const lines = this.text.split('\n').filter(line => line.trim());
        if (lines.length > 0) {
          const line = lines.shift();
          this.text = lines.join('\n');
          this.canContinue = lines.length > 0;
          return line;
        }
        this.canContinue = false;
        return "";
      },
      
      ChooseChoiceIndex: function(index) {
        if (this.currentChoices[index]) {
          this.currentChoices[index].choose();
        }
      },
      
      currentChoices: [],
      variablesState: {
        variables: {},
        getVariableValue: function(name) {
          return this.variables[name] || 0;
        },
        setVariableValue: function(name, value) {
          this.variables[name] = value;
        }
      },
      
      BindExternalFunction: function(name, func) {
        // Mock external function binding
        console.log(`Mock: Bound external function ${name}`);
      }
    };
  }

  /**
   * Create fallback story when real story fails to load
   * @param {string} storyName - Name of the failed story
   * @param {Error} error - The error that caused the failure
   * @returns {Object} Mock story object
   */
  createFallbackStory(storyName, error) {
    console.warn(`DialogueService: Creating fallback story for "${storyName}" due to:`, error.message);
    
    // Dispatch error notification
    this.dispatcher.dispatch('SHOW_NOTIFICATION', {
      title: 'Story Load Error',
      message: `Failed to load story "${storyName}". Using fallback content.`,
      type: 'warning',
      source: 'dialogue-service'
    }, 'dialogue-service');
    
    return {
      storyName: storyName,
      isFallback: true,
      error: error.message,
      
      // Mock story interface
      Continue: function() {
        return `[FALLBACK STORY for "${storyName}"]\n\nThe original story failed to load due to: ${error.message}\n\nThis is fallback content. The story will continue with basic text.\n\nWhat would you like to do?`;
      },
      
      get canContinue() {
        return false; // Fallback stories are single-use
      },
      
      get currentChoices() {
        return [
          {
            text: "Try reloading the story",
            choose: () => {
              console.log(`User chose to reload "${storyName}"`);
              // Could trigger a reload attempt
            }
          },
          {
            text: "Continue with fallback content",
            choose: () => {
              console.log(`User chose to continue with fallback for "${storyName}"`);
            }
          }
        ];
      },
      
      ChooseChoiceIndex: function(index) {
        if (this.currentChoices[index]) {
          this.currentChoices[index].choose();
        }
      },
      
      currentChoices: [],
      variablesState: {
        variables: {},
        getVariableValue: function(name) {
          return this.variables[name] || 0;
        },
        setVariableValue: function(name, value) {
          this.variables[name] = value;
        }
      },
      
      BindExternalFunction: function(name, func) {
        // Mock external function binding
        console.log(`Fallback: Bound external function ${name}`);
      },
      
      onError: null
    };
  }

  /**
   * Clean up resources
   */
  destroy() {
    // Clean up dialog system components
    if (this.dialogSystem) {
      this.dialogSystem = null;
    }
    if (this.portraitService) {
      this.portraitService.destroy();
      this.portraitService = null;
    }
    if (this.dialogUI) {
      this.dialogUI.destroy();
      this.dialogUI = null;
    }

    // Dispatcher listeners are managed by dispatcher itself
    this.dispatcher = null;
    this.gameState = null;
    this.equipmentManager = null;
  }

  /**
   * Trigger autosave with debouncing
   * @param {string} trigger - What triggered the autosave
   */
  triggerAutosave(trigger) {
    const now = Date.now();
    
    // Debounce autosaves to avoid too frequent saves
    if (now - this.lastAutosaveTime < this.autosaveInterval && this.pendingAutosave) {
      return;
    }
    
    this.lastAutosaveTime = now;
    this.pendingAutosave = true;
    
    // Dispatch autosave event
    this.dispatcher.dispatch('AUTOSAVE_REQUEST', {
      trigger: trigger,
      timestamp: now,
      gameState: this.gameState
    });
    
    // Reset pending flag after delay
    setTimeout(() => {
      this.pendingAutosave = false;
    }, 1000);
    
    console.log(`Autosave triggered by: ${trigger}`);
  }

  /**
   * Get dialog system status for debugging
   */
  getDialogSystemStatus() {
    return {
      dialogSystem: this.dialogSystem ? 'initialized' : 'null',
      portraitService: this.portraitService ? 'initialized' : 'null',
      dialogUI: this.dialogUI ? 'initialized' : 'null',
      lastAutosave: new Date(this.lastAutosaveTime).toISOString(),
      pendingAutosave: this.pendingAutosave
    };
  }
}

// ============================================
// Factory function
// ============================================

/**
 * Create and initialize dialogue service
 */
export function createDialogueService(dispatcher, gameState, equipmentManager) {
  const service = new DialogueService(dispatcher, gameState, equipmentManager);

  // Make inkReady promise available globally
  if (typeof window !== 'undefined') {
    window.inkReady = service.readyPromise;
  }

  return service;
}

// ============================================
// Backward Compatibility
// ============================================

if (typeof window !== 'undefined') {
  window.DialogueService = DialogueService;
  window.createDialogueService = createDialogueService;
}
