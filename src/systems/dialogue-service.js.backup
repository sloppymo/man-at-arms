// ============================================
// Dialogue Service
// Centralized external function bindings for Ink.js integration
// Uses dispatcher exclusively for clean service boundaries
// ============================================

import { EVENT_TYPES } from '../core/dispatcher.js';
import { createDialogSystem } from './dialog-system.js';
import { createPortraitService } from './portrait-service.js';
import { createDialogUI } from '../ui/dialog-ui.js';
import { createTagRouter } from '../ink/tag-router.js';
import { CHARACTERS } from '../data/characters.js';

/**
 * Dialogue Service class that handles all Ink.js external function bindings
 * Uses dispatcher for clean separation of concerns
 */
export class DialogueService {
  constructor(dispatcher, gameState, equipmentManager) {
    this.dispatcher = dispatcher;
    this.gameState = gameState;
    this.equipmentManager = equipmentManager;
    this.stories = {};
    this.currentStory = null;

    // Initialize dialog system components
    this.dialogSystem = createDialogSystem(dispatcher, gameState);
    this.portraitService = createPortraitService(dispatcher);
    this.dialogUI = createDialogUI(dispatcher);
    this.tagRouter = createTagRouter(dispatcher);

    // Autosave tracking
    this.lastAutosaveTime = 0;
    this.autosaveInterval = 30000; // 30 seconds
    this.pendingAutosave = false;

    // Initialize inkReady promise
    this.readyPromise = this.initializeStories();

    this.setupEventListeners();
  }

  /**
   * Handle mode change events
   */
  handleModeChange(event) {
    const newMode = event.payload || event;
    console.log(`MODE_CHANGE received:`, newMode);
    
    // Update UI when entering dialogue mode
    if (newMode === 'dialogue') {
      console.log('Updating UI for dialogue mode');
      if (typeof updateDisplay === 'function') {
        updateDisplay();
      }
    }
  }

  /**
   * Handle combat trigger events
   */
  handleCombatTrigger(event) {
    const combatData = event.payload || event;
    console.log('Combat triggered:', combatData);
    
    // Dispatch combat event for other systems to handle
    this.dispatcher.dispatch('COMBAT_START', combatData);
  }

  /**
   * Handle show notification events
   */
  handleShowNotification(event) {
    const notification = event.payload || event;
    console.log('Show notification:', notification);
    
    // Create notification if UI function is available
    if (typeof showNotification === 'function') {
      showNotification(notification.message, notification.type || 'info');
    }
  }

  /**
   * Calculate time of day from game minutes
   * @param {number} minutes - Total minutes since start
   * @returns {Object} - { period: string, visibility: number }
   */
  getTimeOfDay(minutes) {
    const hour = (Math.floor(minutes / 60) % 24);

    if (hour >= 5 && hour < 8) return { period: 'dawn', visibility: 0.8 };
    if (hour >= 8 && hour < 17) return { period: 'day', visibility: 1.0 };
    if (hour >= 17 && hour < 20) return { period: 'dusk', visibility: 0.7 };
    return { period: 'night', visibility: 0.4 }; // Harder to spot/be spotted
  }

  /**
   * Seeded random number generator for deterministic encounters
   * @param {string|number} seed - Seed value
   * @returns {number} - Random number between 0 and 1
   */
  seededRandom(seed) {
    let x = seed;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    return ((x * 0x2545F4914F6CDD1D) >>> 0) / 4294967296; // 0-1
  }

  /**
   * Roll encounter using seeded RNG
   * @param {string} seed - Encounter seed from game state
   * @param {string} region - Region identifier
   * @param {string} timeOfDay - Time period
   * @returns {Object} - Encounter result
   */
  rollEncounter(seed, region, timeOfDay) {
    const rng = this.seededRandom(seed + region + timeOfDay);
    
    // Encounter tables by region and time
    const encounterTables = {
      forest: {
        day: ['bandits', 'merchants', 'peasants'],
        night: ['bandits', 'patrol'],
        dawn: ['patrol', 'nothing'],
        dusk: ['bandits', 'merchants']
      },
      town: {
        day: ['merchants', 'peasants', 'patrol'],
        night: ['patrol', 'nothing'],
        dawn: ['patrol', 'peasants'],
        dusk: ['merchants', 'peasants']
      },
      castle: {
        day: ['patrol', 'merchants'],
        night: ['patrol', 'nothing'],
        dawn: ['patrol'],
        dusk: ['patrol']
      },
      default: {
        day: ['bandits', 'merchants', 'peasants', 'patrol'],
        night: ['bandits', 'patrol', 'nothing'],
        dawn: ['patrol', 'nothing'],
        dusk: ['bandits', 'merchants']
      }
    };
    
    // Get appropriate table
    const regionTable = encounterTables[region] || encounterTables.default;
    const timeTable = regionTable[timeOfDay] || regionTable.day;
    
    // Select encounter
    const encounterIndex = Math.floor(rng * timeTable.length);
    return {
      type: timeTable[encounterIndex],
      rng: rng,
      region: region,
      timeOfDay: timeOfDay
    };
  }

  /**
   * Initialize stories by loading JSON files
   */
  async initializeStories() {
    console.log('DialogueService: Loading stories...');
    
    try {
      // Load available story files
      const storyFiles = [
        'overworld/forest_test'
      ];
      
      let loadedCount = 0;
      let failedCount = 0;
      
      for (const storyName of storyFiles) {
        try {
          // Load compiled JSON files instead of raw .ink
          if (typeof window !== 'undefined' && window.fetch) {
            const jsonPath = `stories/${storyName}.json`;
            console.log(`DialogueService: Loading story "${storyName}" from ${jsonPath}`);
            
            const response = await fetch(jsonPath);
            
            if (response.ok) {
              const jsonContent = await response.text();
              
              // Validate JSON content
              if (!jsonContent || jsonContent.trim().length === 0) {
                throw new Error('Empty JSON content');
              }
              
              console.log(`DialogueService: Loaded story JSON "${storyName}" (${jsonContent.length} bytes)`);
              
              // Validate JSON structure
              let parsedJson;
              try {
                parsedJson = JSON.parse(jsonContent);
                
                // Basic structure validation
                if (!parsedJson.inkVersion) {
                  throw new Error('Missing inkVersion in JSON');
                }
                if (!parsedJson.root) {
                  throw new Error('Missing root in JSON');
                }
                
                console.log(`DialogueService: JSON validation passed for "${storyName}" (inkVersion: ${parsedJson.inkVersion})`);
                
              } catch (parseError) {
                console.error(`DialogueService: JSON parsing failed for "${storyName}":`, parseError);
                this.stories[storyName] = this.createFallbackStory(storyName, parseError);
                failedCount++;
                continue;
              }
              
              // Create Ink.js story if available
              if (typeof window !== 'undefined' && window.inkjs && window.inkjs.Story) {
                try {
                  const story = new window.inkjs.Story(parsedJson);
                  
                  // Enhanced error handler
                  story.onError = (error) => {
                    console.error(`Ink story error in "${storyName}":`, error);
                    this.dispatcher.dispatch('STORY_ERROR', {
                      storyName,
                      error: error.message,
                      source: 'ink'
                    }, 'dialogue-service');
                    return null;
                  };
                  
                  // Test story functionality
                  try {
                    // Test basic functionality
                    const canContinue = story.canContinue;
                    const currentChoices = story.currentChoices;
                    console.log(`DialogueService: Story "${storyName}" functionality test passed`);
                  } catch (testError) {
                    console.warn(`DialogueService: Story "${storyName}" functionality test failed:`, testError);
                    throw testError;
                  }
                  
                  this.stories[storyName] = story;
                  this.bindExternals(story);
                  console.log(`DialogueService: ✅ Successfully loaded Ink story "${storyName}"`);
                  loadedCount++;
                  
                } catch (inkError) {
                  console.warn(`DialogueService: Failed to create Ink story for "${storyName}":`, inkError);
                  this.stories[storyName] = this.createFallbackStory(storyName, inkError);
                  failedCount++;
                }
              } else {
                console.warn(`DialogueService: inkjs not available, storing raw JSON for "${storyName}"`);
                this.stories[storyName] = parsedJson;
                loadedCount++;
              }
            } else {
              throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
          } else {
            console.warn(`DialogueService: Skipping ${storyName} - not in browser environment`);
            failedCount++;
          }
        } catch (error) {
          console.warn(`DialogueService: Failed to load story "${storyName}":`, error);
          this.stories[storyName] = this.createFallbackStory(storyName, error);
          failedCount++;
        }
      }
      
      // Summary
      console.log(`DialogueService: Story loading complete - ${loadedCount} loaded, ${failedCount} failed`);
      
      // Dispatch initialization complete event
      this.dispatcher.dispatch('STORIES_INITIALIZED', {
        total: storyFiles.length,
        loaded: loadedCount,
        failed: failedCount,
        available: Object.keys(this.stories)
      }, 'dialogue-service');
      
      return loadedCount > 0;
      
    } catch (error) {
      console.error('DialogueService: Critical failure during story initialization:', error);
      this.dispatcher.dispatch('STORY_INIT_CRITICAL_ERROR', {
        error: error.message,
        source: 'dialogue-service'
      }, 'dialogue-service');
      return false;
    }
  }

  /**
   * Switch to a specific story
   */
  switchStory(storyName) {
    if (this.stories[storyName]) {
      this.currentStory = this.stories[storyName];
      if (typeof window !== 'undefined') {
        window.inkStory = this.currentStory;
        // Ensure the story persists even if page reloads
        window.inkStory._storyName = storyName;
        console.log(`DialogueService: Set window.inkStory to story "${storyName}"`);
        console.log(`DialogueService: window.inkStory type:`, typeof window.inkStory);
        console.log(`DialogueService: window.inkStory has Continue:`, typeof window.inkStory.Continue);
      }
      console.log(`DialogueService: Switched to story "${storyName}"`);
      return true;
    }
    console.warn(`DialogueService: Story "${storyName}" not found`);
    console.log(`DialogueService: Available stories:`, Object.keys(this.stories));
    return false;
  }

  /**
   * Get the current active story
   */
  getCurrentStory() {
    return this.currentStory;
  }

  /**
   * Ensure window.inkStory is set to current story
   */
  ensureInkStory() {
    if (typeof window !== 'undefined' && this.currentStory) {
      window.inkStory = this.currentStory;
      return true;
    }
    return false;
  }

  /**
   * Setup event listeners for dialog events
   */
  setupEventListeners() {
    // Dialog system events for autosave
    this.dispatcher.subscribe('DIALOG_STARTED', () => {
      this.triggerAutosave('dialog_start');
    });

    this.dispatcher.subscribe('DIALOG_CHOICE', () => {
      this.triggerAutosave('dialog_choice');
    });

    this.dispatcher.subscribe('DIALOG_ENDED', () => {
      this.triggerAutosave('dialog_end');
    });

    // Existing event listeners
    this.dispatcher.subscribe('STAT_CHANGE', (event) => {
      this.handleStatChange(event);
    });

    this.dispatcher.subscribe('RELATIONSHIP_CHANGE', (event) => {
      this.handleRelationshipChange(event);
    });

    this.dispatcher.subscribe('EQUIPMENT_OPEN', () => {
      this.handleOpenEquipment();
    });

    this.dispatcher.subscribe('TRIGGER_COMBAT', (event) => {
      this.handleCombatTrigger(event);
    });

    this.dispatcher.subscribe('SHOW_NOTIFICATION', (event) => {
      this.handleShowNotification(event);
    });

    this.dispatcher.subscribe('MODE_CHANGE', (event) => {
      this.handleModeChange(event);
    });

    this.dispatcher.subscribe('TRIGGER_ENCOUNTER', (event) => {
      const storyPath = event.story || event.payload?.story;
      console.log(`TRIGGER_ENCOUNTER received:`, event);
      console.log(`Available stories:`, Object.keys(this.stories));
      
      if (this.switchStory(storyPath)) {
        this.dispatcher.dispatch(EVENT_TYPES.MODE_CHANGE, 'dialogue');
      } else {
        console.warn(`Failed to switch to story: ${storyPath}`);
      }
    });

    this.dispatcher.subscribe('TRIGGER_COMBAT', (event) => {
      this.handleTriggerCombat(event);
    });

    this.dispatcher.subscribe('TRIGGER_SKIRMISH', (event) => {
      this.handleTriggerSkirmish(event);
    });
  }

  /**
   * Bind all external functions to a story instance with enhanced error handling and type safety
   * @param {Object} story - Ink.js story instance
   */
  bindExternals(story) {
    if (!story || !story.BindExternalFunction) {
      console.error('DialogueService: Invalid story instance for external binding');
      return;
    }

    console.log('DialogueService: Binding external functions with enhanced safety...');

    // Helper function for safe binding with error wrapping
    const safeBind = (name, fn, validator = null) => {
      try {
        // Create wrapper function with error handling and type safety
        const wrappedFn = (...args) => {
          try {
            console.log(`DialogueService: External function "${name}" called with args:`, args);
            
            // Type validation if validator provided
            if (validator && !validator(...args)) {
              console.warn(`DialogueService: Type validation failed for "${name}" with args:`, args);
              this.dispatcher.dispatch('SHOW_NOTIFICATION', {
                title: 'Function Error',
                message: `Invalid arguments for ${name}`,
                type: 'warning',
                source: 'ink'
              }, 'dialogue-service');
              return null;
            }
            
            // Execute the original function
            const result = fn(...args);
            
            // Log successful execution
            console.log(`DialogueService: External function "${name}" executed successfully, result:`, result);
            
            return result;
            
          } catch (error) {
            console.error(`DialogueService: Error in external function "${name}":`, error);
            
            // Dispatch error notification
            this.dispatcher.dispatch('SHOW_NOTIFICATION', {
              title: 'Function Error',
              message: `Error in ${name}: ${error.message}`,
              type: 'error',
              source: 'ink'
            }, 'dialogue-service');
            
            // Return safe default to prevent story crash
            return null;
          }
        };
        
        story.BindExternalFunction(name, wrappedFn);
        console.log(`DialogueService: ✅ Bound external function: ${name}`);
        
      } catch (bindingError) {
        console.error(`DialogueService: Failed to bind external function "${name}":`, bindingError);
      }
    };

    // Type validators
    const validators = {
      number: (arg) => typeof arg === 'number' && !isNaN(arg),
      string: (arg) => typeof arg === 'string',
      positiveNumber: (arg) => typeof arg === 'number' && arg > 0 && !isNaN(arg),
      nonEmptyString: (arg) => typeof arg === 'string' && arg.trim().length > 0
    };

    // Core game functions with enhanced safety
    safeBind('advanceTime', (minutes) => {
      // Type conversion and validation
      const timeMinutes = parseInt(minutes) || 0;
      if (timeMinutes < 0) {
        console.warn('DialogueService: advanceTime called with negative value:', minutes);
        return 0;
      }
      
      // Update game state
      if (this.gameState.overworld) {
        this.gameState.overworld.time = (this.gameState.overworld.time || 0) + timeMinutes;
        console.log(`DialogueService: Advanced time by ${timeMinutes} minutes, new time: ${this.gameState.overworld.time}`);
      }
      
      // Dispatch event for other systems
      this.dispatcher.dispatch('TIME_ADVANCED', {
        minutes: timeMinutes,
        newTime: this.gameState.overworld.time,
        source: 'ink'
      }, 'dialogue-service');
      
      return timeMinutes;
    }, validators.positiveNumber);

    safeBind('getSupplies', () => {
      try {
        // Return supplies as string for Ink compatibility
        const supplies = this.gameState.overworld?.supplies || {};
        const suppliesStr = JSON.stringify(supplies);
        console.log(`DialogueService: getSupplies called, returning:`, suppliesStr);
        return suppliesStr;
      } catch (error) {
        console.error('DialogueService: Error in getSupplies:', error);
        return '{}';
      }
    });

    safeBind('consumeSupply', (type, amount) => {
      // Type conversion and validation
      const supplyType = String(type || '').trim();
      const consumeAmount = parseInt(amount) || 0;
      
      if (!supplyType || consumeAmount <= 0) {
        console.warn('DialogueService: consumeSupply called with invalid args:', { type, amount });
        return false;
      }
      
      try {
        // Check if supply exists and has enough quantity
        const supplies = this.gameState.overworld?.supplies || {};
        if (!supplies[supplyType] || supplies[supplyType] < consumeAmount) {
          console.log(`DialogueService: Not enough ${supplyType} (have: ${supplies[supplyType]}, need: ${consumeAmount})`);
          return false;
        }
        
        // Consume the supply
        supplies[supplyType] -= consumeAmount;
        console.log(`DialogueService: Consumed ${consumeAmount} ${supplyType}, remaining: ${supplies[supplyType]}`);
        
        // Dispatch event for UI updates
        this.dispatcher.dispatch('SUPPLY_CONSUMED', {
          type: supplyType,
          amount: consumeAmount,
          remaining: supplies[supplyType],
          source: 'ink'
        }, 'dialogue-service');
        
        return true;
        
      } catch (error) {
        console.error('DialogueService: Error in consumeSupply:', error);
        return false;
      }
    }, validators.nonEmptyString);

    safeBind('showImage', (imagePath) => {
      // Validate image path
      if (!imagePath || typeof imagePath !== 'string') {
        console.warn('DialogueService: Invalid image path provided to showImage:', imagePath);
        this.dispatcher.dispatch('SHOW_NOTIFICATION', {
          title: 'Image Error',
          message: 'Invalid image path',
          type: 'warning',
          source: 'ink'
        }, 'dialogue-service');
        return;
      }

      // Dispatch with error handling wrapper
      this.dispatcher.dispatch('SHOW_IMAGE', {
        imagePath,
        source: 'ink',
        onError: (error) => {
          console.warn(`DialogueService: Failed to load image "${imagePath}":`, error);
          this.dispatcher.dispatch('SHOW_NOTIFICATION', {
            title: 'Image Not Found',
            message: `Could not load image: ${imagePath}`,
            type: 'warning',
            source: 'ink'
          }, 'dialogue-service');
        }
      }, 'dialogue-service');
    }, validators.nonEmptyString);

    // Enhanced stat functions with type safety
    safeBind('changeStat', (stat, delta) => {
      if (!stat || typeof stat !== 'string') {
        console.warn('DialogueService: changeStat called with invalid stat:', stat);
        return false;
      }
      
      const statDelta = parseFloat(delta) || 0;
      if (statDelta === 0) {
        console.log('DialogueService: changeStat called with zero delta for', stat);
        return true;
      }
      
      this.dispatcher.dispatch(EVENT_TYPES.STAT_CHANGE, {
        stat: stat.trim(),
        delta: statDelta,
        source: 'ink'
      }, 'dialogue-service');
      
      return true;
    }, validators.string);

    safeBind('getPlayerReputation', () => {
      try {
        const reputation = this.gameState.stats?.reputation || 0;
        console.log(`DialogueService: getPlayerReputation called, returning:`, reputation);
        return reputation;
      } catch (error) {
        console.error('DialogueService: Error in getPlayerReputation:', error);
        return 0;
      }
    });

    safeBind('modifyRelation', (characterId, change) => {
      const charId = String(characterId || '').trim();
      const relationChange = parseInt(change) || 0;
      
      if (!charId) {
        console.warn('DialogueService: modifyRelation called with invalid characterId:', characterId);
        return false;
      }
      
      this.dispatcher.dispatch('RELATIONSHIP_CHANGE', {
        characterId: charId,
        change: relationChange,
        source: 'ink'
      }, 'dialogue-service');
      
      console.log(`DialogueService: Modified relation for ${charId} by ${relationChange}`);
      return true;
    }, validators.nonEmptyString);

    // Additional utility functions
    safeBind('formatCurrency', (pence) => {
      const currency = parseInt(pence) || 0;
      if (currency >= 240) {
        const pounds = Math.floor(currency / 240);
        const remainingPence = currency % 240;
        return `${pounds}£ ${remainingPence}d`;
      }
      return `${currency}d`;
    }, validators.number);

    safeBind('rollDice', (modifier = 0) => {
      const mod = parseInt(modifier) || 0;
      const roll = Math.floor(Math.random() * 10) + 1;
      const result = roll + mod;
      console.log(`DialogueService: rollDice(${mod}) = ${roll} + ${mod} = ${result}`);
      return result;
    });

    console.log(`DialogueService: External function binding complete for story`);
  }

  /**
   * Handle stat changes from external functions
   */
  handleStatChange(event) {
      };
    });

    // Narrative authoring helper
    story.BindExternalFunction('doCheck', (stat, difficulty = 12, bonus = 0) => {
      const result = story.BindExternalFunction('resolveAction')(stat, difficulty, bonus);
      return result.success;
    });

    // Equipment checks
    story.BindExternalFunction('hasShieldEquipped', () => {
      // Use equipment manager if available
      if (this.equipmentManager && this.equipmentManager.hasShieldEquipped) {
        return this.equipmentManager.hasShieldEquipped();
      }

      // Fallback to global function
      return typeof window.hasShieldEquipped === 'function' ? window.hasShieldEquipped() : false;
    });

    // Chapter progress
    story.BindExternalFunction('markChapterStarted', (chapterId) => {
      this.dispatcher.dispatch('CHAPTER_START', {
        chapterId,
        source: 'ink'
      }, 'dialogue-service');
    });

    story.BindExternalFunction('markChapterCompleted', (chapterId) => {
      this.dispatcher.dispatch('CHAPTER_COMPLETE', {
        chapterId,
        source: 'ink'
      }, 'dialogue-service');
    });

    // Chevauchée externals
    story.BindExternalFunction('advanceTime', (minutes) => {
      const state = this.gameState.overworld;
      state.time = (state.time + minutes) % 1440; // Wrap to 24 hours

      // Decay heat over time (1 heat per hour)
      const oldHeat = state.heat;
      state.heat = Math.max(0, state.heat - Math.floor(minutes / 60));

      // Trigger events: hunger check, fatigue recovery, etc.
      this.dispatcher.dispatch('OV_TIME_PASSED', {
        minutes,
        newTime: state.time,
        timeOfDay: this.getTimeOfDay(state.time)
      }, 'dialogue-service');

      return state.time; // Return for Ink display
    });

    story.BindExternalFunction('addHeat', (amount) => {
      const state = this.gameState.overworld;
      const oldHeat = state.heat;
      state.heat = Math.min(100, Math.max(0, state.heat + amount));

      // Alert on thresholds
      const thresholds = [
        { at: 25, msg: "The locals are whispering..." },
        { at: 50, msg: "Patrols have been spotted nearby." },
        { at: 75, msg: "You hear horns in the distance!" },
        { at: 90, msg: "The garrison is hunting you!" }
      ];

      thresholds.forEach(t => {
        if (oldHeat < t.at && state.heat >= t.at) {
          this.dispatcher.dispatch('SHOW_NOTIFICATION', {
            title: 'Heat Rising',
            message: t.msg,
            type: 'warning'
          }, 'dialogue-service');
        }
      });

      return state.heat;
    });

    story.BindExternalFunction('discoverHex', (q, r) => {
      const key = `${q},${r}`;
      const wasNew = !this.gameState.overworld.discovered.includes(key);
      if (wasNew) {
        this.gameState.overworld.discovered.push(key);
      }

      // Return if this was new discovery (for Ink conditional text)
      return wasNew;
    });

    story.BindExternalFunction('getSupplies', () => {
      return JSON.stringify(this.gameState.overworld.supplies);
    });

    story.BindExternalFunction('consumeSupply', (type, amount) => {
      const supplies = this.gameState.overworld.supplies;
      const current = supplies[type] || 0;
      const canConsume = current >= amount;

      // Update supplies if possible
      if (canConsume) {
        supplies[type] = current - amount;
      }

      // Return detailed result for Ink compatibility
      return JSON.stringify({
        success: canConsume,
        consumed: canConsume ? amount : 0,
        remaining: canConsume ? current - amount : current
      });
    });

    console.log('DialogueService: All external functions bound to dispatcher');
  }

  /**
   * Handle stat change events
   */
  handleStatChange(event) {
    const { stat, delta, options = {}, source } = event.payload || event;

    if (source === 'ink') {
      // This came from Ink, don't echo back
      return;
    }

    // Apply stat change through proper channels
    if (typeof window.applyStatChange === 'function') {
      window.applyStatChange(stat, delta, options);
    }

    // Sync back to Ink story if available
    if (window.inkStory && window.inkStory.variablesState) {
      try {
        // Check if variable exists before assigning
        if (window.inkStory.variablesState[stat] !== undefined) {
          window.inkStory.variablesState[stat] = this.gameState.stats[stat];
        } else {
          console.warn(`Stat variable '${stat}' not declared in Ink story - skipping sync`);
        }
      } catch (error) {
        console.warn(`Failed to sync stat ${stat} to Ink:`, error);
      }
    }
  }

  /**
   * Handle equipment open requests
   */
  handleOpenEquipment(event) {
    // Dispatch mode change instead of direct UI manipulation
    if (window.setMode) {
      window.setMode(this.gameState, 'equipment');
    }
  }

  /**
   * Handle dialogue start requests
   */
  handleStartDialogue(event) {
    const { scene } = event.payload || {};

    // Set mode and prepare scene
    if (window.setMode) {
      window.setMode(this.gameState, 'dialogue');
    }

    if (scene && window.loadScene) {
      window.loadScene(scene);
    }
  }

  /**
   * Handle combat trigger requests
   */
  handleTriggerCombat(event) {
    const { enemyId } = event.payload || {};

    // Set combat mode and initialize
    if (window.setMode) {
      window.setMode(this.gameState, 'combat');
    }

    // Additional combat initialization can be added here
    console.log(`DialogueService: Combat triggered with enemy: ${enemyId}`);
  }

  /**
   * Handle show image requests
   */
  handleShowImage(event) {
    const { imagePath } = event.payload || {};

    // For now, log and dispatch a notification; UI can handle displaying
    console.log(`DialogueService: Showing image: ${imagePath}`);
    this.dispatcher.dispatch('SHOW_NOTIFICATION', {
      title: 'Scene Image',
      message: `Displaying: ${imagePath}`,
      type: 'info',
      imagePath, // Include image path for UI to use
      source: 'ink'
    }, 'dialogue-service');
  }

  /**
   * Get service status for debugging
   */
  getStatus() {
    return {
      hasDispatcher: !!this.dispatcher,
      hasGameState: !!this.gameState,
      hasEquipmentManager: !!this.equipmentManager,
      dispatcherListeners: this.dispatcher && this.dispatcher.listenerCount ? 
        this.dispatcher.listenerCount() : 'N/A'
    };
  }

  /**
   * Initialize dialog system with character data
   */
  async initializeDialogSystem() {
    try {
      // Register all characters with portrait service
      Object.values(CHARACTERS).forEach(character => {
        this.portraitService.registerCharacter(character.id, character.portrait);
      });

      // Load sample dialog data
      await this.loadSampleDialogs();

      console.log('Dialog system initialized successfully');
      return true;
    } catch (error) {
      console.error('Failed to initialize dialog system:', error);
      return false;
    }
  }

